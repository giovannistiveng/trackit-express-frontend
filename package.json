{
  "name": "trackit-express-frontend",
  "version": "2.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage && node scripts/verificar-cobertura.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:reporte": "playwright show-report e2e/reporte",
    "lint": "ng lint && node scripts/verificar-arquitectura.mjs",
    "lint:sonar": "eslint \"src/**/*.ts\" -f json -o reports/eslint.json",
    "sonar": "sonar-scanner-npm"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/service-worker": "^21.2.26",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0",
    "lucide-static": "1.73.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "sonarqube-scanner": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8"
  },
  "description": "Frontend de TrackIt Express - Angular 21.2, TypeScript, Tailwind CSS, PWA",
  "overrides": {
    "minimatch@^10.0.0": "^11.0.4",
    "glob@^13.0.0": "^14.0.3",
    "node-forge": "^1.4.3"
  }
}
