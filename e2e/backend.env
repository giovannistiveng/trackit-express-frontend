# Backend para las pruebas de punta a punta (Playwright lo levanta solo, en el puerto 3300).
# Las variables que ya existan en el entorno tienen prioridad (así el CI cambia la base de datos).
NODE_ENV=development
PORT=3300
PUBLIC_URL=http://localhost:4300
FRONTEND_URL=http://localhost:4300

# Base de datos SOLO para E2E (se crea sola). Usuario, clave, servidor y puerto se toman del
# .env del backend si no están definidos en el entorno.
# DATABASE_URL vacía: nunca usar la URL de la base de desarrollo
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trackit_e2e
DB_SSL=false

JWT_SECRET=secreto-solo-para-pruebas-e2e-no-usar-en-produccion
RATE_LIMIT_DISABLED=true
GEO_MODO=sin-red
NEQUI_MODO=simulado
NEQUI_SIMULADO_SEGUNDOS=2
UPLOADS_DIR=uploads/e2e

# Nada real: sin correo, push ni Cloudinary (vacías tapan los valores del .env del backend)
SMTP_HOST=
FCM_SERVICE_ACCOUNT_FILE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CLOUDINARY_CLOUD_NAME=
LOG_LEVEL=WARN
LOG_TO_CONSOLE=false
LOG_DIR=logs/e2e
